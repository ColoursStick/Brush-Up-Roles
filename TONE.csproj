<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
		<GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
		<GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
		<!--
		  ⚠️ 程序集名必须是 BUR。
		     Resources 下的内嵌资源名 = 程序集名 + 路径，代码里一律用
		     Assembly.GetManifestResourceStream("TONE.Resources...") 取。
		     两者必须保持一致，否则所有图片/翻译/配置都读不到
		     （表现为背景消失、按钮失灵）。
		     C# 命名空间仍保留 TONE，不做无谓的大范围改动。
		-->
		<AssemblyName>BUR</AssemblyName>
		<RootNamespace>TONE</RootNamespace>
		<Description>Brush Up Roles</Description>
		<Authors>ColoursStick</Authors>
		<LangVersion>12.0</LangVersion>
		<Platforms>Windows;Android</Platforms>
		<AmongUs>D:\Program Files (x86)\Steam\steamapps\common\Among Us</AmongUs>
		<!--<AmongUs>C:\Program Files\Epic Games\AmongUs</AmongUs>-->
		<Configurations>Debug;Release;Beta</Configurations>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Optimize>True</Optimize>
		<CodePage>65001</CodePage>
		<!--
		  目标游戏版本。
		    v19 起 Among Us 改为 64 位，游戏选项类版本号从 V11 升到 V12
		    （类型差异收敛在 GameVersionAliases.cs）。

		  用法（照 Aeterna-End 的做法）：
		    v18:  dotnet build -c Release -p:Platform=Windows
		    v19:  dotnet build -c Release -p:Platform=Windows -p:GameV19=true
		                  -p:GameLibsInteropPath="<游戏目录>\BepInEx\interop"

		  ⚠️ 官方 GameLibs 尚未发布 2026.9.29（v19 对应版本），
		     所以 v19 必须用 GameLibsInteropPath 指向游戏目录里
		     BepInEx 生成好的 interop。有该路径时不会走 NuGet 的 GameLibs。
		-->
		<GameV19 Condition="'$(GameV19)' == ''">false</GameV19>
		<GameLibsInteropPath Condition="'$(GameLibsInteropPath)' == ''"></GameLibsInteropPath>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Platform)' == 'Windows' and '$(GameV19)' == 'true' ">
		<DefineConstants>TRACE;PC;BUR_GAME_V19</DefineConstants>
		<GameLibsVersion>2026.9.29</GameLibsVersion>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Platform)' == 'Windows' and '$(GameV19)' != 'true' ">
		<DefineConstants>TRACE;PC</DefineConstants>
		<GameLibsVersion>2026.8.18</GameLibsVersion>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Platform)' == 'Android' ">
		<DefineConstants>TRACE;ANDROID</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include=".\Resources\**" />
		<EmbeddedResource Include="token.env" />
	</ItemGroup>

	<!--
	  游戏更新早于 GameLibs 发包时：直接引用游戏目录里 BepInEx 已生成的
	  core / interop。此时不再使用 NuGet 的 GameLibs（避免两边版本不一致）。
	-->
	<ItemGroup Condition="'$(GameLibsInteropPath)' != ''">
		<Reference Include="$(GameLibsInteropPath)\*.dll" Private="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Condition="$(Platform)=='Windows' And '$(GameLibsInteropPath)' == ''" Include="AmongUs.GameLibs.Steam" Version="$(GameLibsVersion)" PrivateAssets="all" />
		<PackageReference Condition="$(Platform)=='Android'" Include="AmongUs.GameLibs.Android" Version="2026.3.17" PrivateAssets="all" />

		<PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.692" Private="false" ExcludeAssets="runtime;native" />
	</ItemGroup>

	<ItemGroup>
		
		<PackageReference Include="Costura.Fody" Version="5.8.0-alpha0098">
			<IncludeAssets>runtime; compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="nuget.local\" />
	</ItemGroup>

	<Target Name="EnsureTokenEnvExists" BeforeTargets="BeforeBuild">
		<Exec Condition=" '$(OS)' == 'Windows_NT' " Command="if not exist token.env (echo API_TOKEN=REPLACE THIS ONLY IF YOU GOT YOUR OWN API TOKEN &gt; token.env)" />
		<Exec Condition=" '$(OS)' != 'Windows_NT' " Command="if [ ! -f token.env ]; then echo API_TOKEN=REPLACE THIS ONLY IF YOU GOT YOUR OWN API TOKEN &gt; token.env; fi" />
	</Target>

	<Target Name="Copy" AfterTargets="Build" Condition="'$(AmongUs)' != ''">
		<Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(AmongUs)/BepInEx/plugins/" Condition="'$(Configuration)' == 'Debug'" />
		<Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(AmongUs)/BepInEx/plugins/" Condition="'$(Configuration)' == 'Beta'" />
		<Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(AmongUs)/BepInEx/plugins/" Condition="'$(Configuration)' == 'Release'" />
	</Target>
</Project>
